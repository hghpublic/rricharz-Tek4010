{
    "cmake.useCMakePresets": "always",
    "cmake.configurePreset": "default",
    "cmake.buildPreset": "default",
    "cmake.environment": {
        "LSAN_OPTIONS": "suppressions=${workspaceFolder}/raylib.asan.supp:print_suppressions=1",
        "ASAN_OPTIONS": "log_path=${workspaceFolder}/dev/asan/logs/raylib.asan.log"
    },
    "files.insertFinalNewline": true,
    "editor.detectIndentation": false,
    "editor.rulers": [
        80
    ],
    "C_Cpp.codeAnalysis.clangTidy.checks.disabled": [
        "cppcoreguidelines-avoid-magic-numbers"
    ],
    "C_Cpp.codeAnalysis.exclude": {
        "**/build": true
    }
}
