{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default vcpkg configuration",
            "description": "Use the vcpkg toolchain; the project selects its host-specific configuration.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "macos-gcc-16",
            "displayName": "macOS with Homebrew GCC 16",
            "description": "Requires VCPKG_ROOT. Configure with the workspace vcpkg triplet and Homebrew GCC 16 toolchain.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "linux-vcpkg",
            "displayName": "Linux with vcpkg",
            "description": "Configure Linux with the regular vcpkg toolchain and host triplet.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "macos-gcc-16",
            "configurePreset": "macos-gcc-16",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "linux-vcpkg",
            "configurePreset": "linux-vcpkg",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ]
}
